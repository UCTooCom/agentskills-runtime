# AgentSkills Runtime Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Runtime Configuration
# ===========================================
# Log level: error | info | debug | trace
# Default: info
LOG_LEVEL=info



# ===========================================
# Server Configuration
# ===========================================

# Server listening port
# Default: 8080
# For production HTTPS, use standard port 443
# For development, use custom port like 8443
PORT=8080

# Server bind address
# Default: 0.0.0.0 (all interfaces)
# For local development only: 127.0.0.1
# runtime 服务绑定 host , 如需公网访问请改为 0.0.0.0 并配置合法证书
HOST=127.0.0.1

# Backend URL (determines HTTP/HTTPS mode)
# If starts with https://, HTTPS mode is enabled
# If starts with http:// or not set, HTTP mode is used
# BACKEND_URL=http://localhost:8080
# BACKEND_URL=https://your-domain.com

# SSL Certificate Configuration (for HTTPS mode)
# Paths to SSL certificate and private key files
# Supports both relative and absolute paths
# Relative paths are relative to the executable directory
# Default: ssl/server.crt and ssl/server.key
# CERT_FILE_NAME=ssl/server.crt
# KEY_FILE_NAME=ssl/server.key

# Examples for different certificate locations:
# Relative path (recommended for development)
# CERT_FILE_NAME=ssl/server.crt
# KEY_FILE_NAME=ssl/server.key

# Absolute path (recommended for production)
# CERT_FILE_NAME=/etc/ssl/certs/your-domain.com.crt
# KEY_FILE_NAME=/etc/ssl/private/your-domain.com.key

# Windows absolute path
# CERT_FILE_NAME=C:/ssl/server.crt
# KEY_FILE_NAME=C:/ssl/server.key

# ===========================================
# Public Repository Search API Tokens (Optional)
# ===========================================
# These tokens are OPTIONAL. Without tokens, search still works but with lower rate limits.
# 
# Rate Limits:
# - GitHub: 10 requests/min without token, 30 requests/min with token
# - Gitee: Limited without token, higher with token
# - AtomGit: Limited without token, higher with token

# GitHub Personal Access Token
# Get your token: https://github.com/settings/tokens
# Required scopes: public_repo (for searching public repositories)
# Note: GitHub uses "Authorization: token" header
# IMPORTANT: Uncomment and set your token, or leave commented for anonymous access
# GITHUB_TOKEN=your_github_personal_access_token

# Gitee Private Token
# Get your token: https://gitee.com/profile/personal_access_tokens
# Note: Gitee uses access_token URL parameter
# IMPORTANT: Uncomment and set your token, or leave commented for anonymous access
# GITEE_TOKEN=your_gitee_private_token

# AtomGit Access Token
# Get your token: https://atomgit.com/-/profile/personal_access_tokens
# Note: AtomGit uses access_token URL parameter (Gitee-compatible API)
# IMPORTANT: Uncomment and set your token, or leave commented for anonymous access
# ATOMGIT_TOKEN=your_atomgit_access_token

# ===========================================
# LLM Model Configuration (Optional)
# ===========================================
# Configure your preferred LLM provider for AI-powered features

# Model Provider: openai | dashscope | stepfun | deepseek | sophnet | maas | zhipuai | siliconflow | google | moonshot | ark | openrouter | ollama | llamacpp | orbitai | gmicloud | atomgit | tokendance | evomap | arcbench
#
# ⚠ MODEL_CONFIG 必须写成 "provider:modelName"（带冒号），程序不做任何二次处理：
#   不补 provider 前缀、不按模型名猜通道、也不改写模型 ID。
#   裸模型名（如 MODEL_CONFIG=deepseek-v4-flash）会直接报错退出，改配置即可。
#   模型名以该通道自己 {base}/models 返回的登记名为准，逐字抄；
#   写厂商官方名而网关不认时，网关会回 provider_not_selected（2026-10-01 ArcBench 实测）。
# ⚠ 当前通道：ArcBench 网关（2026-10-01 切换，见下方 ArcBench 段）。
#   BASE_URL 取 ARCBENCH_BASE_URL、KEY 取 ARCBENCH_API_KEY（模板里是占位，需自行替换）。
#   回退示例（DeepSeek 官方，2026-09-24 已充值）：
#       MODEL_PROVIDER=deepseek
#       MODEL_NAME=deepseek-flash
#       MODEL_CONFIG=deepseek:deepseek-flash
MODEL_PROVIDER=arcbench
MODEL_NAME=deepseek-v4-flash-vision-exp
MODEL_CONFIG=arcbench:deepseek-v4-flash-vision-exp

# L3 插件进程（long-running-task）的模型凭据
# 插件是独立 exe 进程，不继承宿主内存中的模型配置，只能经进程环境传参。
# 链路：本文件 → Config.env.load() → std.env.setVariable → plugin_manager.launchStdio
#       用 getVariables() 全量传给插件 exe → 插件拉起的 scripts/*.py 子进程
# 未配置时 parse_goal.py 会 raise，长程任务的规划/验核降级为空骨架。
# ⚠ 通道必须与宿主一致：本项目实际走 ArcBench 网关（见下方 ArcBench 段），
#   模型名用网关登记名 deepseek-v4-flash-vision-exp（非 deepseek 官方 deepseek-flash）。
#   网关要求 prompt 含 "json" 字样才放行 response_format=json_object，改 prompt 时别删。
# LRT_MODEL_BASE_URL=https://api.arc-bench.com/v1
# LRT_MODEL_API_KEY=your_arcbench_api_key
# LRT_MODEL_NAME=deepseek-v4-flash-vision-exp
# ⚠ 换宿主通道时这三项必须与 MODEL_PROVIDER / MODEL_CONFIG / ARCBENCH_* 一起改：
#   插件不继承宿主的 MODEL_*，只认 LRT_MODEL_*，漏改即宿主走 A 通道、插件走 B 通道。

# 长程任务宿主侧执行者（根因 D）：不配即走默认（启用 + 默认产物目录 + 30 分钟陈旧阈值）
# LRT_HOST_ROUND_ENABLED=1
# LRT_ROUND_OUTPUT_DIR=
# LRT_HOST_ROUND_LOCK_STALE_MS=1800000

# ===========================================
# AI Model Provider Configurations
# ===========================================

# OpenAI (GPT-4, GPT-3.5, etc.)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# StepFun (阶跃星辰)
# STEPFUN_API_KEY=your_stepfun_api_key
# STEPFUN_BASE_URL=https://api.stepfun.com/v1

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# AtomGit（文本生成 API，OpenAI 兼容接口）
# 官文地址: https://api.atomgit.com/api/v5
# 获取令牌: https://atomgit.com/-/profile/personal_access_tokens
# ATOMGIT_API_KEY=your_atomgit_access_token
# ATOMGIT_BASE_URL=https://api.atomgit.com/api/v5

# Sophnet
SOPHNET_BASE_URL=https://www.sophnet.com/api/open-apis/v1
SOPHNET_API_KEY=your_sophnet_api_key

# 华为云 MaaS (ModelArts Studio)
# MAAS_API_KEY=your_maas_api_key
# MAAS_BASE_URL=https://api.modelarts-maas.com/v2
# MAAS_MODEL_NAME=qwen3-coder-480b-a35b-instruct

# 智谱 AI (ZhipuAI)
# ZHIPU_API_KEY=your_zhipuai_api_key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 阿里云 DashScope
# DASHSCOPE_API_KEY=your_dashscope_api_key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# SiliconFlow
# SILICONFLOW_API_KEY=your_siliconflow_api_key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Google Gemini
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Moonshot (月之暗面)
# MOONSHOT_API_KEY=your_moonshot_api_key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 火山引擎 ARK (字节跳动)
# ARK_API_KEY=your_ark_api_key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (本地部署)
# OLLAMA_BASE_URL=http://localhost:11434

# LLama.cpp (本地推理)
# LLAMACPP_BASE_URL=http://localhost:8080

# OrbitAI
# ORBITAI_API_KEY=your_orbitai_api_key
# ORBITAI_BASE_URL=https://aiapi.orbitai.global/v1

# GMI Cloud
# GMICLOUD_API_KEY=your_gmicloud_api_key
# GMICLOUD_BASE_URL=https://api.gmi-serving.com/v1
# GMI Cloud 支持的模型:
# - deepseek-ai/DeepSeek-R1

# Tokendance (大模型聚合平台)
# API文档: https://tokendance.space
# 支持多种协议: OpenAI、Anthropic 等
# Tokendance 支持的模型 (通过 tokendance:MODEL_ID 使用):
# - minimax-m2.5 (MiniMax M2.5)
# - deepseek-v3.2 (DeepSeek V3.2)
# TOKENDANCE_API_KEY=your_tokendance_api_key
# TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1

# EvoMap (大模型聚合网关，OpenAI 兼容 Chat Completions)
# 官文地址: https://api.evomap.ai/v1
# ⚠ 双 key 不互通：ek_ 开头的 key 只能打 /api/hub/kg/*，
#   sk-evomap- 开头的 key 才能打 /v1/chat/completions。
#   按你实际调用的端点配 BASE_URL 与 KEY，两者不能混着用。
# ⚠ 该网关走 Cloudflare AAAA 双栈，部分机器无 IPv6 出口会导致 TLS 读 0 字节，
#   此时优先换纯 IPv4 的通道（如 sophnet）。
# EVMAP_API_KEY=your_evomap_api_key
# EVMAP_BASE_URL=https://api.evomap.ai/v1
# 模型名写在上面 MODEL_CONFIG 里（形如 MODEL_CONFIG=evomap:evomap-deepseek-v4-flash），
# 这里的名字只是示例：网关自报的登记名未必等于 deepseek 官方名。

# ArcBench (Agentic Software Factory Hackathon 平台，OpenAI 兼容；纯 IPv4)
# 官文地址: https://api.arc-bench.com/v1
# 一个 key 代理多家模型（deepseek / glm / kimi / minimax / qwen 等），
# 接入前务必先 curl {base}/models 拉一遍登记名再写。
# ⚠ 网关登记名与厂商官方名可能不同：deepseek 系模型的登记名是 `deepseek-v4-flash`，
#   不是 deepseek 官方的 `deepseek-flash`（发后者网关回 provider_not_selected，2026-10-01 实测）。
# ⚠ 模型名不做任何改写：写 `arcbench:deepseek-v4-flash` 就发 deepseek-v4-flash。
#   deepseek 系在该网关有两个登记名：纯文本/工具调用用 `deepseek-v4-flash`，
#   需传图（视觉）用 `deepseek-v4-flash-vision-exp`，两者不通用的，别混。
# ARCBENCH_API_KEY=your_arcbench_api_key
# ARCBENCH_BASE_URL=https://api.arc-bench.com/v1
# 模型名写在上面 MODEL_CONFIG 里。本项目宿主实配视觉版（对应上方 MODEL_NAME）：
#     MODEL_CONFIG=arcbench:deepseek-v4-flash-vision-exp
# 只跑文本/工具调用可改回 `arcbench:deepseek-v4-flash`；接入前请以 curl {base}/models 为准。

# ===========================================
# Skill Installation Configuration
# ===========================================
# Path where skills are installed and loaded from
# This single configuration controls both:
#   - Where new skills are installed (via API/CLI)
#   - Where the runtime loads skills from
#
# Priority: 
#   1. SKILL_INSTALL_PATH environment variable
#   2. Default: ./skills (relative to runtime working directory)
#
# Examples:
#   SKILL_INSTALL_PATH=./skills                    # Relative path (recommended)
#   SKILL_INSTALL_PATH=/opt/agentskills/skills     # Absolute path (Linux/macOS)
#   SKILL_INSTALL_PATH=C:/agentskills/skills       # Absolute path (Windows)
#
# Note: When using JavaScript SDK, the default working directory is:
#   node_modules/@opencangjie/skills/runtime/<platform>-<arch>/release/
# To install skills in your project root, use an absolute path or navigate 
# to your project directory before starting the runtime.
SKILL_INSTALL_PATH=./skills
# Progressive skill loading configuration
PROGRESSIVE_SKILL_LOADING_ENABLED=true
# GitHub API Token (用于搜索 GitHub 仓库)
GITHUB_TOKEN=ghp_your_github_token

# Gitee API Token (用于搜索 Gitee 仓库)
GITEE_TOKEN=your_gitee_token

# AtomGit API Token (用于搜索 AtomGit 仓库)
ATOMGIT_TOKEN=your_atomgit_token

# Firecrawl Configuration
# Firecrawl API Key (用于网络搜索和内容抓取)
# 获取方式: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Firecrawl API URL (可选，用于私有化部署)
# 默认使用 Firecrawl 云服务: https://api.firecrawl.dev
# 私有化部署示例: http://localhost:3002
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Firecrawl 默认搜索限制
# 默认返回的搜索结果数量
FIRECRAWL_DEFAULT_LIMIT=10

# ============================================
# ORM Database Configuration
# ============================================
# 数据库驱动配置
# DATABASE_URL=postgresql://postgres:password@localhost:5432/uctoo
orm_drivers=postgres
orm_defaultDriver=postgres
# orm_connectionUrl=postgresql://postgres:password@localhost:5432/uctoo

# PostgreSQL 驱动特定配置
# postgres_orm_connectionUrl=postgresql://postgres:password@localhost:5432/uctoo

# ============================================
# WebMCP Configuration
# ============================================
# WebMCP 请求超时时间（秒）
# 由于大模型响应可能需要较长时间，建议设置较大值
# 默认值：120秒（2分钟）
# 长推理任务建议设置：300秒（5分钟）或更长
# WEBMCP_REQUEST_TIMEOUT=600

# WebMCP 聊天链路主 agent 的 ReAct 步数预算（Config.chatReactSteps，默认 600）
# 30 步对「读多个文件 + 探查工程 + 落盘产物」这类探索型请求必撞顶；撞顶后任务未闭环，
# 成果只以聊天正文吐出、不落盘。
# 600 的来源：runtime 自主推进单个大型软件工程 spec（如 .codeartsdoer/specs/AgenticSoftwareFactoryHackathon）
# 时实测 60 步仍触顶并导致产物未落盘（2026-10-03，日志 20261003-191027），故放大一个量级。
# 任务收敛时会自然退出，不会空转到上限；只想收窄时用 CHAT_REACT_STEPS=100 之类覆盖即可。
# CHAT_REACT_STEPS=600

# ============================================
# Token Configuration
# ============================================
# Token Info
# Access Token 有效期（秒）
# 20 DAYS: 1728000 Sec
ACCESS_TOKEN_VALIDITY_SEC=1728000

# JWT 密钥
AUTH_CORE_SECRET=your_secret_key

# Refresh Token 有效期（秒）
# 70 DAYS: 6048000 Sec
REFRESH_TOKEN_VALIDITY_SEC=6048000

# Token 签发者
TOKEN_ISSUER=yourapi.example.com

# Token 受众
TOKEN_AUDIENCE=example.com

# ============================================
# Web CRUD Generator Configuration
# ============================================
# Web code generation output directory
# This controls where the web-admin frontend code is generated
WEB_CRUD_OUTPUT_DIR=D:/UCT/projects/miniapp/Delivery/uctoo-admin/apps/web-admin

# ============================================
# 动态大模型通道（T030 Agent 自动切换开关）
# ============================================
# 允许 Agent 通过 llm_channel_switch 工具自行切换全局默认通道。
# 安全默认值：false —— 关闭时 Agent 只能只读/探测，切换需管理员在界面操作。
# 开启后每次切换都会写审计（llm_channel_audit，source=agent）。
# 改动需重启生效（启动装配期读取）。
LLM_CHANNEL_AUTO_SWITCH=false

# ============================================
# 插件运行时增量发现（T025）
# ============================================
# 周期调谐间隔（秒）：重新扫描 plugin.yaml，把启动后新增的插件目录加载进来。
# 这样新增 skills/<name>/（含 plugin.yaml）后无需重启宿主。
#   60  = 默认，每分钟扫一次
#   0   = 关闭周期调谐（仍可用 Agent 工具 plugin_refresh 手动触发一次）
# 调谐是幂等的：已加载插件一律跳过；目录被删掉的插件**不会**被卸载
# （下线请显式用 plugin_deactivate 工具或 pluginuninstall）。
PLUGIN_RECONCILE_INTERVAL_SECONDS=60
