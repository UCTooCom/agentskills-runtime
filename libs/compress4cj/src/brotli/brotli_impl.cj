/**
 * 位读取器，从字节数组读取比特。
 */
public class BrotliBitReader {
    private var data: Array<UInt8>
    private var pos: Int64 = 0
    private var bitBuf: UInt64 = 0
    private var bitCount: Int64 = 0
    private var endPos: Int64

    public init(data: Array<UInt8>) {
        this.data = data
        this.endPos = data.size
        this.pos = 0
        this.bitBuf = 0
        this.bitCount = 0
    }

    public init(data: Array<UInt8>, offset: Int64, length: Int64) {
        this.data = data
        this.pos = offset
        this.endPos = offset + length
        this.bitBuf = 0
        this.bitCount = 0
    }

    public func ensureBits(n: Int64): Unit {
        while (bitCount < n) {
            if (pos >= endPos) {
                bitBuf <<= 8
                bitCount += 8
            } else {
                bitBuf = (bitBuf << 8) | UInt64(data[pos])
                pos += 1
                bitCount += 8
            }
        }
    }

    public func peekBits(n: Int64): Int64 {
        ensureBits(n)
        Int64((bitBuf >> (bitCount - n)) & ((1 << n) - 1))
    }

    public func dropBits(n: Int64): Unit {
        if (n > bitCount) {
            bitCount = 0
        } else {
            bitCount -= n
        }
    }

    public func readBits(n: Int64): Int64 {
        if (n <= 0) { return 0 }
        let result = peekBits(n)
        dropBits(n)
        result
    }

    public func alignToByte(): Unit {
        let bitsToDrop = bitCount & 7
        if (bitsToDrop > 0) {
            dropBits(bitsToDrop)
        }
    }

    public func getPosition(): Int64 { pos }
    public func getBitCount(): Int64 { bitCount }
    public func remaining(): Int64 { (endPos - pos) * 8 + bitCount }
}

/**
 * 读取变长整数 (用于 MNIBBLES 等)。
 */
public func readVarLenUint(reader: BrotliBitReader): Int64 {
    let nibble = reader.readBits(4)
    if (nibble == 0) {
        return 0
    }
    var result: Int64 = 0
    for (i in 0..nibble) {
        result = (result << 4) | reader.readBits(4)
    }
    result
}

/**
 * 解码 window bits (RFC 7932 Section 2.1)。
 */
public func decodeWindowBits(reader: BrotliBitReader): Int64 {
    if (reader.readBits(1) == 1) {
        // WBITS = 16 (默认)
        return 16
    }
    if (reader.readBits(1) == 1) {
        // [1 bit 0][1 bit 1]...
        var n: Int64 = 0
        while (reader.readBits(1) == 0) { n += 1 }
        reader.readBits(n)  // 末尾比特
        return 17 + n
    }
    // [00...]
    var n: Int64 = 0
    while (reader.readBits(1) == 0) { n += 1 }
    if (n == 0) {
        return 8
    }
    let v = reader.readBits(n)
    if (v == 1) {
        return 7 + n
    } else {
        return 8 + v
    }
}

/**
 * 从静态字典获取单词。
 */
public func brotliGetDictionaryWord(length: Int64, index: Int64): Array<UInt8> {
    let off = Int64(BROTLI_DICT_OFFSETS[length])
    let wordStart = off + index * length
    if (wordStart + length > BROTLI_DICT_DATA_SIZE) {
        return []
    }
    Array<UInt8>(length, { i => BROTLI_DICT_DATA[wordStart + i] })
}

/**
 * 完整 Brotli 解码器。
 * 当前由于实现复杂性（完整的 Huffman 树构建、上下文模型、距离映射等），
 * 此函数仅作为占位符。纯仓颉实现的完整 Brotli 解压器需要在 future 版本中完成。
 * 当前非压缩 metablock 格式的解压请使用 brotliDecompress（位于 brotli.cj）。
 */
public func brotliDecode(data: Array<UInt8>): Array<UInt8> {
    throw Zlib4cjException(
        "Brotli 完整解压不可用：纯仓颉解码器暂未实现完整的 Brotli 压缩数据解码。" +
        "非压缩 brotli 数据流的解压请使用 brotliDecompress（zlib4cj）。")
}
