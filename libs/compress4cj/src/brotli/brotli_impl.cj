package compress4cj.brotli
import compress4cj.common.Zlib4cjException


/**
 * Brotli 解码器 (RFC 7932)，纯仓颉实现。
 *
 * 支持：
 *   - 窗口大小 10-24
 *   - 压缩和非压缩 metablock
 *   - 简单前缀码 (1-4 符号)
 *   - 复杂前缀码 (规范 Huffman 树)
 *   - 所有上下文模式 (0/1/2)
 *   - 静态字典引用与变换
 *   - NIBBLES/SKIPBYTES 元数据块
 */

// ===== 常量 =====

let BROTLI_MAX_WINDOW_BITS: Int64 = 24
let BROTLI_MIN_WINDOW_BITS: Int64 = 10
let BROTLI_FAST_BITS: Int64 = 8
let BROTLI_NUM_INSERT_CODES: Int64 = 704
let BROTLI_NUM_COPY_CODES: Int64 = 704

