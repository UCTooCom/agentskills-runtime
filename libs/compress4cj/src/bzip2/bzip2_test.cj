package compress4cj.bzip2

import compress4cj.common.bytesEqual

/**
 * bzip2 单元测试
 *
 * 使用预先准备的 bzip2 压缩数据验证解压正确性。
 */

// ===== 测试数据 =====
// 由 Python bz2.compress(b"Hello, bzip2!") 生成
private let BZIP2_HELLO_DATA: Array<UInt8> = [
    0x42, 0x5a, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x6b, 0x1d, 0x3e, 0xc1, 0x0, 0x0,
    0x2, 0x1d, 0x80, 0x60, 0x4, 0x10, 0x0, 0x0, 0x40, 0x12, 0x24, 0xc0, 0x10, 0x20, 0x0, 0x31,
    0x3, 0x40, 0xd0, 0x20, 0x1, 0xa6, 0x8f, 0x3, 0xaa, 0xac, 0x82, 0x84, 0xf8, 0xbb, 0x92, 0x29,
    0xc2, 0x84, 0x83, 0x58, 0xe9, 0xf6, 0x8
]
private let EXPECTED_HELLO: Array<UInt8> = [
    0x48, 0x65, 0x6c, 0x6c, 0x6f, 0x2c, 0x20, 0x62,
    0x7a, 0x69, 0x70, 0x32, 0x21
]

// 由 Python bz2.compress(b"Hello, World! This is a longer bzip2 decompression test ...") 生成
private let BZIP2_LONG_DATA: Array<UInt8> = [
    0x42, 0x5a, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x33, 0xa8, 0x48, 0x3e, 0x0, 0x0,
