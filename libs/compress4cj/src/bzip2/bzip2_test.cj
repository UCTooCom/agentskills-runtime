// 空数据 bz2（仅文件尾）
private let BZIP2_EMPTY_DATA: Array<UInt8> = [
    0x42, 0x5a, 0x68, 0x39, 0x17, 0x72, 0x45, 0x38, 0x50, 0x90, 0x00, 0x00, 0x00, 0x00
]

// ===== 辅助函数 =====

private func decodeTest(name: String, compressed: Array<UInt8>, expected: Array<UInt8>): Unit {
    let decompressed = bzip2Decompress(compressed)
    if (!bytesEqual(decompressed, expected)) {
        throw Exception("${name}: mismatch, got ${decompressed.size} bytes, expected ${expected.size}")
    }
}

// ===== 测试用例 =====

@Test
func testBzip2DecompressHello(): Unit {
    decodeTest("hello", BZIP2_HELLO_DATA, EXPECTED_HELLO)
}

@Test
func testBzip2DecompressLong(): Unit {
    decodeTest("long", BZIP2_LONG_DATA, EXPECTED_LONG)
}

@Test
func testBzip2DecompressEmpty(): Unit {
    let decompressed = bzip2Decompress(BZIP2_EMPTY_DATA)
    if (!(decompressed.size == 0)) {
        throw Exception("empty: expected 0 bytes, got ${decompressed.size}")
    }
}

@Test
func testBzip2DecompressEmptyInput(): Unit {
    let data: Array<UInt8> = []
    let result = bzip2Decompress(data)
    if (!(result.size == 0)) {
        throw Exception("empty input: expected 0 bytes, got ${result.size}")
    }
}

@Test
func testBzip2InvalidMagic(): Unit {
    try {
        let _ = bzip2Decompress([0x00, 0x00, 0x00])
        throw Exception("should have thrown on invalid magic")
    } catch (e: Exception) {
        // expected
    }
}

@Test
func testBzip2TruncatedData(): Unit {
    try {
        let _ = bzip2Decompress(BZIP2_HELLO_DATA[..10])
        throw Exception("should have thrown on truncated data")
    } catch (e: Exception) {
        // expected
    }
}
