    0x0, 0x68, 0x54, 0xfd, 0x35, 0x4c, 0x43, 0x41, 0xea, 0x1a, 0x1e, 0xa7, 0xa8, 0x6, 0xa9, 0xe9,
    0x91, 0x1a, 0x7a, 0x8d, 0x34, 0xda, 0x80, 0x1e, 0xa0, 0x46, 0x61, 0x59, 0xe8, 0x71, 0xdb, 0x9f,
    0x5f, 0xb4, 0x35, 0x32, 0x75, 0x5b, 0x2e, 0xa4, 0xd0, 0x90, 0x32, 0x48, 0x53, 0x39, 0xd, 0x62,
    0xed, 0xe4, 0x70, 0x75, 0x48, 0x70, 0x99, 0x32, 0x39, 0xd1, 0xe4, 0xc4, 0xd6, 0xad, 0xf3, 0x3c,
    0xf6, 0x2, 0x7, 0x1f, 0x62, 0x21, 0x8f, 0x88, 0x8c, 0x2f, 0x9a, 0xa9, 0xad, 0xd2, 0x72, 0xaa,
    0x2, 0xa5, 0xa7, 0x12, 0x35, 0x80, 0xf, 0xa3, 0xfe, 0x2e, 0xe4, 0x8a, 0x70, 0xa1, 0x20, 0x67,
    0x50, 0x90, 0x7c
]
private let EXPECTED_LONG: Array<UInt8> = [
    0x48, 0x65, 0x6c, 0x6c, 0x6f, 0x2c, 0x20, 0x57, 0x6f, 0x72, 0x6c, 0x64, 0x21, 0x20, 0x54, 0x68,
    0x69, 0x73, 0x20, 0x69, 0x73, 0x20, 0x61, 0x20, 0x6c, 0x6f, 0x6e, 0x67, 0x65, 0x72, 0x20, 0x62,
