let token512Array = "ewogICJrMSI6ICJ2MSIsCiAgImtpZCI6ICJrZXlJZCIsCiAgImFsZyI6ICJIUzUxMiIsCiAgInR5cCI6ICJKV1QiCn0..iH3F6MbRXzn5lv00rjjJNjeA6Fw0LlGXb5zz83iAUYUs_hJ3x7t8FRUausDGXbj5U4tUK3qocMH8FiLWcwsffw"

main() {
   
  let require256 = JWT.require(Algorithm.HMAC256("admin"));
  let require384 = JWT.require(Algorithm.HMAC384("admin"));
  let require512 = JWT.require(Algorithm.HMAC512("admin"));
  let require256Array = JWT.require(Algorithm.HMAC256([24,64]));
  let require384Array = JWT.require(Algorithm.HMAC384([24,64]));
  let require512Array = JWT.require(Algorithm.HMAC512([24,64]));

  try {
    // require.ignoreIssuedAt();

    require256.build().verify(token256)
    require384.build().verify(token384)
    require512.build().verify(token512)
    require256Array.build().verify(token256Array)
    require384Array.build().verify(token384Array)
    require512Array.build().verify(token512Array)

    return 0
  } catch (e: Exception){
    return 1
  } 
}
