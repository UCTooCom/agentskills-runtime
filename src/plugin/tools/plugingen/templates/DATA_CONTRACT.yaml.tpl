# 数据契约（DATA_CONTRACT.yaml）—— plugingen 生成的**骨架**
# 技能：{{name}}（数据库 {{dbName}}）
#
# ⚠️ 这是机器生成的骨架，不是可直接交付的契约。生成器只能确定地从 db_info 得到：
#     表名 / 列名 / 列类型 / 是否可空 / 列注释；
#   以下三处**必须由人工补齐**（生成器无从推断业务语义）：
#     - role          ：这张表在本技能里承担什么角色
#     - idempotent_key：真正的业务幂等键（默认填了 ["id"]，那只是主键占位）
#     - write_rule    ：写入纪律（先查后写？禁止状态倒退？软删过滤？）
#     - sample_rows    ：真实示例值 —— **不是可选项**（见下方说明）
#
# ── 为什么 sample_rows 不能省 ──────────────────────────────────────────────
# spec §5.16 要的是"让大模型准确 CRUD"。光有字段名和类型，模型只能猜格式：
# uuid 的形态、时间戳的精度、jsonb 里面套几层、枚举到底写 'passed' 还是 'PASS'。
# 契约里没有示例行，等于把这些问题留给模型临场发挥，而这正是写入错列的根因。
# 生成器不查业务数据（受行级权限约束，且示例应体现语义而非巧合），故留空待人工补齐。
#
# ── 一致性 ────────────────────────────────────────────────────────────────
# 本文件与数据库实际结构的一致性由契约漂移检测比对告警（spec §5.16 规则 7）：
# 改表必须同步改这里，否则运行时告警。
#
# ── schema ────────────────────────────────────────────────────────────────
#   tables[]:
#     name / access / role
#     idempotent_key: []        先按幂等键查再写，查到多条必须拒绝（不得静默覆盖）
#     columns[]:                每项含 name/type/required/enum/fk/example/comment
#     write_rule: []            写入纪律
#     sample_rows: []           真实示例值 —— 不是可选项

tables:
{{tablesDecl}}
